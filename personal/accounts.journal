# --- COMODITY DEFINITIONS ---
commodity $
  format $1,000.00

# Fixes the "3 @ $50" error for your tickets
# This declares the "empty" commodity for quantities like '3'
commodity 1,000.00
commodity 1,000.00 L

# --- DEFAULT COMMODITY ---
D $1,000.00

# --- PREFERENCES ---
check-commodities


check-accounts
