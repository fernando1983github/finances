# change a specific word, anywhere
#alias /\bpuerta-toreo\b/ = pta-toreo
#alias /\bmaintenance\b/ = mtce
#alias /\butilities\b/ = utils

#alias /:b:d:e$/ = :b:newname:e
#alias /:d:/ = :newname:

#alias /\binvestments\b/ = invst
alias assets:schneider:investments:company_plan = assets:schneider:invst:company_plan
alias assets:bank:hsbc:investments:hsbcdc_bfp = assets:bank:hsbc:invst:hsbcdc_bfp

# --- Short Aliases for Speed and layout ---
alias expenses:housing:utilities:gas:san-pedro:maintenance = housing:utilities:gas:san-pedro:maint
alias expenses:housing:utilities:gas:puerta-toreo = housing:utilities:gas:pta-toreo
alias expenses:housing:utilities:gas:puerta-toreo:maintenance = housing:utilities:pta-toreo:maint
alias expenses:housing:utilities:electricity:puerta-toreo = housing:utilities:elect:pta-toreo
alias expenses:housing:maintenance:puerta-toreo = housing:maint:pta-toreo
alias expenses:housing:maintenance:san-pedro = housing:maint:san-pedro


include accounts.journal
; journal created 2026-04-01 by hledger
include 2026_inversiones.journal
include 2026_inversiones_schneider.journal




# Since you are receiving money for his insurance, this usually implies you are paying the bill on his behalf, or he is paying you back. Using a Liability account is best so that his money doesn't look like "Income" (which would falsely inflate your earnings).
